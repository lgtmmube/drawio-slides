{
  "name": "drawio-slides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local draw.io workspace with slide frames and image / editable PowerPoint export.",
  "scripts": {
    "setup:editor": "node scripts/setup-editor.mjs",
    "dev": "vite --host 127.0.0.1 --port 48765",
    "build": "vite build",
    "start": "node scripts/serve.mjs --open",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "jszip": "^3.10.1",
    "vite": "^6.1.0"
  }
}
